# ============================================
# fut.invest - Backend Environment Variables
# ============================================

# Server
PORT=3001
NODE_ENV=production

# CORS - Origen permitido (frontend SPA)
FRONTEND_URL=http://localhost:8000

# JWT
# Generado con: openssl rand -base64 48
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Base de Datos
DB_PATH=./data/fut_invest.db

# TOTP Secret (compartido con frontend para validación 2FA)
TOTP_SECRET=change_me_in_production

# Wallet - Límites de transacción
MAX_WITHDRAWAL_PER_DAY=50000
MIN_WITHDRAWAL=10

# Logging
LOG_LEVEL=info

# Sentry (opcional, descomentar en producción)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Access token (JWT)
ACCESS_TOKEN_EXPIRY=15m

# Password Reset
RESET_TOKEN_HOURS=1

# Email Verification
REQUIRE_EMAIL_VERIFICATION=true

# Withdrawal Batch Worker
WITHDRAWAL_WORKER_ENABLED=true
WITHDRAWAL_BATCH_SIZE=10
WITHDRAWAL_POLL_INTERVAL_MS=30000

# Email (SMTP) - Configurar para envío real en producción
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_SECURE=false
# EMAIL_FROM=noreply@futinvest.io
# SENDGRID_API_KEY=your_key_here (alternativa a SMTP)

# SMS (Twilio) - opcional
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_FROM_NUMBER=+1234567890
NOTIFICATION_LOG_SIZE=100

# PostgreSQL (opcional, descomentar para migrar desde SQLite)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/futinvest

# Metrics & Analytics
METRICS_ENABLED=true

# Security (WAF)
WAF_ENABLED=true
WAF_BLOCK_VPN=false
# BLOCKED_COUNTRIES=RU,CN,KP,IR,SY,CU,VE
# BLOCKED_IPS=

# Captcha (reCAPTCHA v2)
CAPTCHA_ENABLED=false
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Referral System
REFERRAL_BONUS_RATE=0.05

# Redis (opcional - fallback a store en memoria)
# REDIS_URL=redis://localhost:6379

# Cache TTL (segundos)
CACHE_TTL=60

# Payment Provider (mock, coinbase_commerce, stripe)
PAYMENT_PROVIDER=mock

# HashiCorp Vault (opcional)
# VAULT_ADDR=https://vault.futinvest.io:8200
# VAULT_TOKEN=hvs.your_vault_token
# VAULT_SECRET_PATH=secret/data/futinvest

# Web Push (VAPID) - generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@futinvest.io

# Analytics (Plausible-compatible)
# ANALYTICS_DOMAIN=futinvest.io
# ANALYTICS_HOST=https://plausible.io

# App Secret (HMAC para webhooks)
APP_SECRET=change_me_in_production
